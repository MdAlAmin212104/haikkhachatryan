{% comment %}
  Our Story Founders Section
  Two-column layout: text content on left, image on right.
  "Rooted in Family, Built on Passion."
{% endcomment %}

<section
  id="our-story-founders-{{ section.id }}"
  class="our-story-founders"
  style="
    background-color: {{ section.settings.background_color }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  "
>
  <div class="our-story-founders__inner page-width">

    <div class="our-story-founders__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="our-story-founders__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="our-story-founders__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="our-story-founders__body rte">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_url }}"
          class="our-story-founders__btn"
          {% if section.settings.button_new_tab %}target="_blank" rel="noopener"{% endif %}
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="our-story-founders__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            class: 'our-story-founders__img',
            widths: '600, 900, 1200',
            sizes: '(min-width: 750px) 50vw, 100vw',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'our-story-founders__img our-story-founders__img--placeholder' }}
      {%- endif -%}
    </div>

  </div>
</section>

{% stylesheet %}
  .our-story-founders {
    background: #fff;
  }

  .our-story-founders__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .our-story-founders__text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .our-story-founders__eyebrow {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c0392b;
    margin: 0;
  }

  .our-story-founders__heading {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.2;
  }

  .our-story-founders__body {
    font-size: 0.95rem;
    color: #444;
    line-height: 1.7;
  }

  .our-story-founders__btn {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 0.75rem 1.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    background: #c0392b;
    color: #fff;
    border: 2px solid #c0392b;
    transition: background 0.2s, border-color 0.2s;
  }

  .our-story-founders__btn:hover {
    background: #a93226;
    border-color: #a93226;
  }

  .our-story-founders__media {
    border-radius: 4px;
    overflow: hidden;
  }

  .our-story-founders__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 4px;
  }

  .our-story-founders__img--placeholder {
    aspect-ratio: 4/3;
    background: #f0f0f0;
  }

  @media screen and (max-width: 749px) {
    .our-story-founders__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .our-story-founders__media {
      order: -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our Story — Founders",
  "tag": "section",
  "class": "our-story-section section-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "Our Founders"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rooted in Family. Built on Passion."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Text",
      "default": "<p>Open Container Wine was created with a simple but powerful belief — that great wine should be accessible to everyone. Inspired by Grandma Rosa's unwavering work ethic and love for hospitality, our family set out to create a place where people can enjoy exceptional wines, learn, celebrate, and make memories.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Learn More About Us"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Our Story — Founders"
    }
  ]
}
{% endschema %}
