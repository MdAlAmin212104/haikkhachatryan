{% comment %}
  Our Story Values Section
  4-column grid of company values with icon, heading, and description.
  "What Drives Us Every Day"
{% endcomment %}

<section
  id="our-story-values-{{ section.id }}"
  class="our-story-values"
  style="
    background-color: {{ section.settings.background_color }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  "
>
  <div class="our-story-values__inner page-width">

    <div class="our-story-values__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="our-story-values__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="our-story-values__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="our-story-values__grid">
        {%- for block in section.blocks -%}
          <div class="our-story-values__card" {{ block.shopify_attributes }}>
            <div class="our-story-values__card-icon">
              {%- if block.settings.icon != blank -%}
                <span>{{ block.settings.icon }}</span>
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="our-story-values__card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="our-story-values__card-desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  .our-story-values {
    background: #fff;
  }

  .our-story-values__inner {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .our-story-values__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
  }

  .our-story-values__eyebrow {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c0392b;
    margin: 0;
  }

  .our-story-values__heading {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.2;
  }

  .our-story-values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .our-story-values__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 2rem 1rem;
    border: 1px solid #f0f0f0;
    border-radius: 8px;
    transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s;
  }

  .our-story-values__card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    border-color: #e8d5d5;
    transform: translateY(-3px);
  }

  .our-story-values__card-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(192, 57, 43, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    transition: background 0.2s;
  }

  .our-story-values__card:hover .our-story-values__card-icon {
    background: rgba(192, 57, 43, 0.14);
  }

  .our-story-values__card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
  }

  .our-story-values__card-desc {
    font-size: 0.875rem;
    color: #666;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 900px) {
    .our-story-values__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 480px) {
    .our-story-values__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our Story — Values",
  "class": "section",
  "blocks": [
    {
      "type": "value",
      "name": "Value Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🏛️",
          "info": "Use an emoji as icon, e.g. 🏛️ ❤️ 🤝 🏆"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Value Title",
          "default": "Heritage"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "We honor many generations of Armenian winemaking and carry our traditions with pride."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "Our Values"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Drives Us Every Day"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Our Story — Values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "icon": "🏛️",
            "title": "Heritage",
            "description": "We honor many generations of Armenian winemaking and carry our traditions with pride."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "❤️",
            "title": "Passion",
            "description": "Every bottle crafted reflects our love for wine and commitment to our customers."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "🤝",
            "title": "Community",
            "description": "Wine brings people together. We create experiences that connect friends and family."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "🏆",
            "title": "Excellence",
            "description": "From our vineyards to your glass, we are dedicated to quality in every detail."
          }
        }
      ]
    }
  ]
}
{% endschema %}
