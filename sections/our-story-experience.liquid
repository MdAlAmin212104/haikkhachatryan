{% comment %}
  Our Story Experience Section
  Full-width CTA with background image.
  "Experience Open Container"
{% endcomment %}

<section
  id="our-story-experience-{{ section.id }}"
  class="our-story-experience"
  style="
    --exp-min-height: {{ section.settings.height }}px;
    --exp-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  {%- if section.settings.background_image != blank -%}
    <div class="our-story-experience__media">
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          class: 'our-story-experience__img',
          widths: '800, 1200, 1600, 2400',
          sizes: '100vw',
          alt: section.settings.background_image.alt
      }}
    </div>
  {%- endif -%}

  <div class="our-story-experience__overlay"></div>

  <div class="our-story-experience__content page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="our-story-experience__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="our-story-experience__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="our-story-experience__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_url }}"
        class="our-story-experience__btn"
        {% if section.settings.button_new_tab %}target="_blank" rel="noopener"{% endif %}
      >
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .our-story-experience {
    position: relative;
    min-height: var(--exp-min-height, 420px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .our-story-experience__media {
    position: absolute;
    inset: 0;
  }

  .our-story-experience__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .our-story-experience__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, var(--exp-overlay-opacity, 0.55));
  }

  .our-story-experience__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    padding-block: 4rem;
    max-width: 560px;
  }

  .our-story-experience__eyebrow {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c0392b;
    margin: 0;
  }

  .our-story-experience__heading {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 700;
    color: #fff;
    margin: 0;
    line-height: 1.15;
  }

  .our-story-experience__subheading {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin: 0;
    max-width: 420px;
  }

  .our-story-experience__btn {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    background: #c0392b;
    color: #fff;
    border: 2px solid #c0392b;
    transition: background 0.2s, border-color 0.2s;
  }

  .our-story-experience__btn:hover {
    background: #a93226;
    border-color: #a93226;
  }

  @media screen and (max-width: 749px) {
    .our-story-experience__content {
      align-items: center;
      text-align: center;
      max-width: 100%;
    }

    .our-story-experience__subheading {
      max-width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our Story Experience",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "height",
      "min": 300,
      "max": 700,
      "step": 20,
      "unit": "px",
      "label": "Min Section Height",
      "default": 440
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 55
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "Visit Our Winery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Experience Open Container"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Join us for a unique wine tasting experience at our Florida location. Walk-ins welcome!"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Book a Wine Experience"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open in new tab",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Our Story — Experience CTA"
    }
  ]
}
{% endschema %}
