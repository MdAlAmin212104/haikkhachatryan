{% comment %}
  Our Story Timeline Section
  Two-column layout: heading on the left, horizontal milestone timeline on the right.
  Each milestone has an SVG icon in a circle, red dot connector, year label, and description.
{% endcomment %}

{%- liquid
  assign milestones = section.blocks
-%}

<section
  id="our-story-timeline-{{ section.id }}"
  class="ost"
  style="
    background-color: {{ section.settings.background_color }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  "
>
  <div class="ost__inner page-width">

    {%- comment -%} LEFT: Heading {%- endcomment -%}
    <div class="ost__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ost__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ost__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- comment -%} RIGHT: Timeline — desktop horizontal track {%- endcomment -%}
    {%- if milestones.size > 0 -%}
      <div class="ost__track" style="--milestone-count: {{ milestones.size }};">

        {%- comment -%} Top row: icons {%- endcomment -%}
        <div class="ost__icons-row">
          {%- for block in milestones -%}
            <div class="ost__icon-wrap" {{ block.shopify_attributes }}>
              <div class="ost__icon-circle">
                {%- if block.settings.custom_svg != blank -%}
                  {{ block.settings.custom_svg }}
                {%- else -%}
                  {%- assign icon = block.settings.icon -%}
                  {%- if icon == 'grape' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="6" r="2"/><circle cx="15" cy="6" r="2"/><circle cx="6" cy="10.5" r="2"/><circle cx="12" cy="10.5" r="2"/><circle cx="18" cy="10.5" r="2"/><circle cx="9" cy="15" r="2"/><circle cx="15" cy="15" r="2"/><circle cx="12" cy="19.5" r="2"/><line x1="12" y1="2" x2="12" y2="4"/></svg>
                  {%- elsif icon == 'plane' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13"/><path d="M22 2L15 22L11 13L2 9L22 2Z"/></svg>
                  {%- elsif icon == 'shop' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                  {%- elsif icon == 'glasses' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 22V12H5l-2-8h18l-2 8h-3v10"/><path d="M8 22h8"/><path d="M12 12v10"/></svg>
                  {%- elsif icon == 'star' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  {%- elsif icon == 'bottle' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6v3.5S17 8 17 12v7a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2v-7c0-4 2-5.5 2-5.5V3z"/><line x1="9" y1="3" x2="15" y2="3"/><line x1="7" y1="14" x2="17" y2="14"/></svg>
                  {%- elsif icon == 'heart' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  {%- elsif icon == 'trophy' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="8 21 12 17 16 21"/><line x1="12" y1="17" x2="12" y2="11"/><path d="M7 4H4a2 2 0 0 0-2 2v1a4 4 0 0 0 4 4h1"/><path d="M17 4h3a2 2 0 0 1 2 2v1a4 4 0 0 1-4 4h-1"/><rect x="7" y="2" width="10" height="9" rx="1"/></svg>
                  {%- elsif icon == 'map' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
                  {%- elsif icon == 'leaf' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 4 13C4 9 8 3 12 2c4 1 8 7 8 11a7 7 0 0 1-7 7z"/><path d="M12 2v9"/><path d="M6.5 9.5L12 15"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="6" r="2"/><circle cx="15" cy="6" r="2"/><circle cx="6" cy="10.5" r="2"/><circle cx="12" cy="10.5" r="2"/><circle cx="18" cy="10.5" r="2"/><circle cx="9" cy="15" r="2"/><circle cx="15" cy="15" r="2"/><circle cx="12" cy="19.5" r="2"/></svg>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- comment -%} Middle row: connecting line with red dots {%- endcomment -%}
        <div class="ost__line-row">
          <div class="ost__line"></div>
          <div class="ost__dots">
            {%- for block in milestones -%}
              <div class="ost__dot"></div>
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%} Bottom row: year + label {%- endcomment -%}
        <div class="ost__labels-row">
          {%- for block in milestones -%}
            <div class="ost__label-wrap">
              {%- if block.settings.year != blank -%}
                <strong class="ost__year">{{ block.settings.year }}</strong>
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <p class="ost__label">{{ block.settings.label }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

      </div>

      {%- comment -%} MOBILE ONLY: self-contained milestone cards {%- endcomment -%}
      <div class="ost__mobile-grid">
        {%- for block in milestones -%}
          <div class="ost__mobile-card" {{ block.shopify_attributes }}>
            <div class="ost__mobile-card-icon">
              {%- if block.settings.custom_svg != blank -%}
                {{ block.settings.custom_svg }}
              {%- else -%}
                {%- assign icon = block.settings.icon -%}
                {%- if icon == 'grape' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="6" r="2"/><circle cx="15" cy="6" r="2"/><circle cx="6" cy="10.5" r="2"/><circle cx="12" cy="10.5" r="2"/><circle cx="18" cy="10.5" r="2"/><circle cx="9" cy="15" r="2"/><circle cx="15" cy="15" r="2"/><circle cx="12" cy="19.5" r="2"/><line x1="12" y1="2" x2="12" y2="4"/></svg>
                {%- elsif icon == 'plane' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13"/><path d="M22 2L15 22L11 13L2 9L22 2Z"/></svg>
                {%- elsif icon == 'shop' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                {%- elsif icon == 'glasses' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 22V12H5l-2-8h18l-2 8h-3v10"/><path d="M8 22h8"/><path d="M12 12v10"/></svg>
                {%- elsif icon == 'star' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- elsif icon == 'bottle' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6v3.5S17 8 17 12v7a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2v-7c0-4 2-5.5 2-5.5V3z"/><line x1="9" y1="3" x2="15" y2="3"/><line x1="7" y1="14" x2="17" y2="14"/></svg>
                {%- elsif icon == 'heart' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                {%- elsif icon == 'trophy' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="8 21 12 17 16 21"/><line x1="12" y1="17" x2="12" y2="11"/><path d="M7 4H4a2 2 0 0 0-2 2v1a4 4 0 0 0 4 4h1"/><path d="M17 4h3a2 2 0 0 1 2 2v1a4 4 0 0 1-4 4h-1"/><rect x="7" y="2" width="10" height="9" rx="1"/></svg>
                {%- elsif icon == 'map' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
                {%- elsif icon == 'leaf' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 4 13C4 9 8 3 12 2c4 1 8 7 8 11a7 7 0 0 1-7 7z"/><path d="M12 2v9"/><path d="M6.5 9.5L12 15"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="6" r="2"/><circle cx="15" cy="6" r="2"/><circle cx="6" cy="10.5" r="2"/><circle cx="12" cy="10.5" r="2"/><circle cx="18" cy="10.5" r="2"/><circle cx="9" cy="15" r="2"/><circle cx="15" cy="15" r="2"/><circle cx="12" cy="19.5" r="2"/></svg>
                {%- endif -%}
              {%- endif -%}
            </div>
            <div class="ost__mobile-card-dot"></div>
            {%- if block.settings.year != blank -%}
              <strong class="ost__mobile-card-year">{{ block.settings.year }}</strong>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <p class="ost__mobile-card-label">{{ block.settings.label }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  .ost__inner {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: center;
  }

  /* ── Left: heading ── */
  .ost__header {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ost__eyebrow {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6B1A2E;
    margin: 0;
  }

  .ost__heading {
    font-size: clamp(1.35rem, 2.5vw, 2rem);
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.25;
  }

  /* ── Right: track ── */
  .ost__track {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Icon row */
  .ost__icons-row {
    display: grid;
    grid-template-columns: repeat(var(--milestone-count, 5), 1fr);
    margin-bottom: 0.75rem;
  }

  .ost__icon-wrap {
    display: flex;
    justify-content: center;
  }

  .ost__icon-circle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1.5px solid #ddd;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .ost__icon-circle svg {
    width: 22px;
    height: 22px;
    color: #6B1A2E;
    display: block;
  }

  .ost__icon-wrap:hover .ost__icon-circle {
    border-color: #6B1A2E;
    box-shadow: 0 0 0 4px rgba(192, 57, 43, 0.1);
  }

  /* Line + dots row */
  .ost__line-row {
    position: relative;
    height: 14px;
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .ost__line {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 1.5px;
    background: #e0e0e0;
  }

  .ost__dots {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(var(--milestone-count, 5), 1fr);
  }

  .ost__dot {
    display: flex;
    justify-content: center;
  }

  .ost__dot::after {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #6B1A2E;
    display: block;
  }

  /* Labels row */
  .ost__labels-row {
    display: grid;
    grid-template-columns: repeat(var(--milestone-count, 5), 1fr);
  }

  .ost__label-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.3rem;
    padding-inline: 4px;
  }

  .ost__year {
    font-size: 0.95rem;
    font-weight: 800;
    color: #1a1a1a;
    display: block;
  }

  .ost__label {
    font-size: 0.75rem;
    color: #666;
    line-height: 1.45;
    margin: 0;
  }

  /* Mobile */
  @media screen and (max-width: 900px) {
    .ost__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .ost__heading {
      font-size: 1.5rem;
    }
  }

  /* On mobile: hide the 3-row desktop track, show card grid instead */
  @media screen and (max-width: 600px) {
    .ost__track {
      display: none;
    }

    .ost__mobile-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .ost__mobile-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.4rem;
      padding: 1rem 0.5rem;
      border: 1px solid #f0eded;
      border-radius: 8px;
    }

    .ost__mobile-card-icon {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      border: 1.5px solid #ddd;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #fff;
      margin-bottom: 0.25rem;
    }

    .ost__mobile-card-icon svg {
      width: 22px;
      height: 22px;
      color: #6B1A2E;
      display: block;
    }

    .ost__mobile-card-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #6B1A2E;
      flex-shrink: 0;
    }

    .ost__mobile-card-year {
      font-size: 0.9rem;
      font-weight: 800;
      color: #1a1a1a;
      display: block;
    }

    .ost__mobile-card-label {
      font-size: 0.75rem;
      color: #666;
      line-height: 1.45;
      margin: 0;
    }
  }

  /* Desktop: hide mobile-only grid */
  @media screen and (min-width: 601px) {
    .ost__mobile-grid {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our Story — Timeline",
  "class": "section",
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        {
          "type": "textarea",
          "id": "custom_svg",
          "label": "SVG Icon Code",
          "info": "Paste your SVG code here. Example: <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><circle cx='12' cy='12' r='10'/></svg>"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Or choose a preset icon",
          "default": "grape",
          "info": "Ignored if SVG Icon Code above is filled in.",
          "options": [
            { "value": "grape",   "label": "🍇 Grapes" },
            { "value": "plane",   "label": "✈️ Airplane / Travel" },
            { "value": "shop",    "label": "🏠 Shop / Home" },
            { "value": "glasses", "label": "🍷 Wine Glasses" },
            { "value": "star",    "label": "⭐ Star / Award" },
            { "value": "bottle",  "label": "🍾 Bottle" },
            { "value": "heart",   "label": "❤️ Heart" },
            { "value": "trophy",  "label": "🏆 Trophy" },
            { "value": "map",     "label": "🗺️ Map / Location" },
            { "value": "leaf",    "label": "🌿 Leaf / Nature" }
          ]
        },
        {
          "type": "text",
          "id": "year",
          "label": "Year / Era Label",
          "default": "1920s"
        },
        {
          "type": "textarea",
          "id": "label",
          "label": "Description",
          "default": "Our family began farming vineyards in Armenia."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "Our Heritage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Journey of Passion Across Generations"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Our Story — Timeline",
      "blocks": [
        {
          "type": "milestone",
          "settings": {
            "icon": "grape",
            "year": "1920s",
            "label": "Our family began farming vineyards in Armenia."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "icon": "plane",
            "year": "1985",
            "label": "Our family moved to Florida with a dream and tradition."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "icon": "shop",
            "year": "2010",
            "label": "We opened our first wine shop and testing room in Florida."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "icon": "glasses",
            "year": "2016",
            "label": "Expanded to a new location and grew our wine family."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "icon": "star",
            "year": "Today",
            "label": "Continuing our legacy and sharing our wines with the world."
          }
        }
      ]
    }
  ]
}
{% endschema %}
