{% comment %}
  Our Story Legacy Section
  Dark background section — image on left, quote + text on right.
  "The Woman Behind Our Legacy"
{% endcomment %}

<section
  id="our-story-legacy-{{ section.id }}"
  class="our-story-legacy"
  style="
    background-color: {{ section.settings.background_color }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  "
>
  <div class="our-story-legacy__inner page-width">

    <div class="our-story-legacy__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 900
          | image_tag:
            class: 'our-story-legacy__img',
            widths: '400, 600, 900',
            sizes: '(min-width: 750px) 40vw, 100vw',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'our-story-legacy__img our-story-legacy__img--placeholder' }}
      {%- endif -%}

      {%- if section.settings.caption != blank -%}
        <div class="our-story-legacy__caption">
          <span class="our-story-legacy__caption-number">{{ section.settings.caption_number }}</span>
          <p class="our-story-legacy__caption-text">{{ section.settings.caption }}</p>
        </div>
      {%- endif -%}
    </div>

    <div class="our-story-legacy__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="our-story-legacy__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="our-story-legacy__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="our-story-legacy__body rte">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.quote != blank -%}
        <blockquote class="our-story-legacy__quote">
          <p class="our-story-legacy__quote-text">{{ section.settings.quote }}</p>
          {%- if section.settings.quote_author != blank -%}
            <cite class="our-story-legacy__quote-author">
              {{ section.settings.quote_author }}
              {%- if section.settings.quote_title != blank -%}
                <span>{{ section.settings.quote_title }}</span>
              {%- endif -%}
            </cite>
          {%- endif -%}
        </blockquote>
      {%- endif -%}
    </div>

  </div>
</section>

{% stylesheet %}
  .our-story-legacy {
    background: #1a1a1a;
  }

  .our-story-legacy__inner {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 4rem;
    align-items: center;
  }

  .our-story-legacy__media {
    position: relative;
  }

  .our-story-legacy__img {
    width: 100%;
    display: block;
    object-fit: cover;
  }

  .our-story-legacy__img--placeholder {
    aspect-ratio: 3/4;
    background: #333;
  }

  .our-story-legacy__caption {
    position: absolute;
    bottom: 1.5rem;
    right: -1.5rem;
    background: #c0392b;
    color: #fff;
    padding: 1rem 1.25rem;
    max-width: 220px;
  }

  .our-story-legacy__caption-number {
    font-size: 2rem;
    font-weight: 800;
    display: block;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .our-story-legacy__caption-text {
    font-size: 0.75rem;
    line-height: 1.4;
    margin: 0;
    font-style: italic;
  }

  .our-story-legacy__content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .our-story-legacy__eyebrow {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c0392b;
    margin: 0;
  }

  .our-story-legacy__heading {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 700;
    color: #fff;
    margin: 0;
    line-height: 1.15;
  }

  .our-story-legacy__body {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.7;
  }

  .our-story-legacy__quote {
    border-left: 3px solid #c0392b;
    padding-left: 1.25rem;
    margin: 0.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .our-story-legacy__quote-text {
    font-size: 1rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
    margin: 0;
  }

  .our-story-legacy__quote-author {
    font-style: normal;
    font-size: 0.85rem;
    font-weight: 700;
    color: #c0392b;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .our-story-legacy__quote-author span {
    font-weight: 400;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media screen and (max-width: 749px) {
    .our-story-legacy__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .our-story-legacy__caption {
      right: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our Story — Legacy",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "caption_number",
      "label": "Caption Stat / Number",
      "default": "56"
    },
    {
      "type": "textarea",
      "id": "caption",
      "label": "Caption Text",
      "default": "Tradition isn't something we inherit, it's something we preserve."
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "The Heart Of Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Woman Behind Our Legacy"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Text",
      "default": "<p>Our story begins with Grandma Rosa, whose passion, resilience, and dedication became the heart of Open Container Wine. She taught us that wine is more than a drink — it's a way to bring people together and create lasting memories.</p>"
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote Text",
      "default": "Wine brings people together. We create experiences that connect friends and family."
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote Author Name",
      "default": "Grandma Rosa"
    },
    {
      "type": "text",
      "id": "quote_title",
      "label": "Quote Author Title",
      "default": "Our Inspiration, Our Foundation"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Our Story — Legacy"
    }
  ]
}
{% endschema %}
