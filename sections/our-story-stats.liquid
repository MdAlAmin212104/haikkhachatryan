{% comment %}
  Our Story Stats Section
  "Our Journey in Numbers" — big stat numbers with labels.
{% endcomment %}

<section
  id="our-story-stats-{{ section.id }}"
  class="our-story-stats"
  style="
    background-color: {{ section.settings.background_color }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  "
>
  <div class="our-story-stats__inner page-width">

    <div class="our-story-stats__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="our-story-stats__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="our-story-stats__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="our-story-stats__grid">
        {%- for block in section.blocks -%}
          <div class="our-story-stats__stat" {{ block.shopify_attributes }}>
            <div class="our-story-stats__number">{{ block.settings.number }}</div>
            {%- if block.settings.label != blank -%}
              <p class="our-story-stats__label">{{ block.settings.label }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  .our-story-stats {
    background: #fff;
  }

  .our-story-stats__inner {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .our-story-stats__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
  }

  .our-story-stats__eyebrow {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c0392b;
    margin: 0;
  }

  .our-story-stats__heading {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.2;
  }

  .our-story-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .our-story-stats__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.5rem;
    border-left: 3px solid #f0f0f0;
    transition: border-color 0.2s;
  }

  .our-story-stats__stat:first-child {
    border-left: none;
  }

  .our-story-stats__stat:hover {
    border-color: #c0392b;
  }

  .our-story-stats__number {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    color: #1a1a1a;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .our-story-stats__label {
    font-size: 0.85rem;
    color: #666;
    line-height: 1.4;
    margin: 0;
    text-align: center;
  }

  @media screen and (max-width: 750px) {
    .our-story-stats__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .our-story-stats__stat {
      border-left: none;
      border-top: 3px solid #f0f0f0;
      padding-top: 1.5rem;
    }

    .our-story-stats__stat:nth-child(-n+2) {
      border-top: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our Story — Stats",
  "class": "section",
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number / Value",
          "default": "70+"
        },
        {
          "type": "textarea",
          "id": "label",
          "label": "Label",
          "default": "Years of Family Heritage"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "By The Numbers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Journey in Numbers"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Our Story — Stats",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": "70+",
            "label": "Years of Family Heritage"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "10,000+",
            "label": "Guests Hosted"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "15+",
            "label": "Premium Wines"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "Thousands",
            "label": "Happy Customers"
          }
        }
      ]
    }
  ]
}
{% endschema %}
