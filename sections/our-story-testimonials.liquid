{% comment %}
  Our Story Testimonials Section
  Star reviews from wine family customers.
  "From Our Wine Family"
{% endcomment %}

<section
  id="our-story-testimonials-{{ section.id }}"
  class="our-story-testimonials"
  style="
    background-color: {{ section.settings.background_color }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  "
>
  <div class="our-story-testimonials__inner page-width">

    <div class="our-story-testimonials__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="our-story-testimonials__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="our-story-testimonials__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="our-story-testimonials__grid" id="testimonials-grid-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="our-story-testimonials__card" {{ block.shopify_attributes }}>
            <div class="our-story-testimonials__stars">
              {%- assign stars = block.settings.rating | default: 5 -%}
              {%- for i in (1..stars) -%}
                <span class="our-story-testimonials__star">★</span>
              {%- endfor -%}
            </div>
            {%- if block.settings.quote != blank -%}
              <blockquote class="our-story-testimonials__quote">
                "{{ block.settings.quote }}"
              </blockquote>
            {%- endif -%}
            {%- if block.settings.author != blank -%}
              <cite class="our-story-testimonials__author">— {{ block.settings.author }}</cite>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  .our-story-testimonials {
    background: #fff;
  }

  .our-story-testimonials__inner {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .our-story-testimonials__header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .our-story-testimonials__eyebrow {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c0392b;
    margin: 0;
  }

  .our-story-testimonials__heading {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.2;
  }

  .our-story-testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .our-story-testimonials__card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    border: 1px solid #e8e8e8;
    border-radius: 8px;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .our-story-testimonials__card:hover {
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.07);
    transform: translateY(-2px);
  }

  .our-story-testimonials__stars {
    display: flex;
    gap: 2px;
  }

  .our-story-testimonials__star {
    color: #f4c430;
    font-size: 1rem;
    line-height: 1;
  }

  .our-story-testimonials__quote {
    font-size: 0.9rem;
    color: #333;
    line-height: 1.6;
    margin: 0;
    font-style: italic;
  }

  .our-story-testimonials__author {
    font-size: 0.8rem;
    font-weight: 600;
    color: #888;
    font-style: normal;
  }

  @media screen and (max-width: 900px) {
    .our-story-testimonials__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 480px) {
    .our-story-testimonials__grid {
      grid-template-columns: 1fr;
    }

    .our-story-testimonials__header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our Story — Testimonials",
  "class": "section",
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Text",
          "default": "One of the most unique wine experiences in Florida. The selection is exceptional and the family is incredible!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Sarah M."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "What Our Guests Say"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Our Wine Family"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Our Story — Testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "One of the most unique wine experiences in Florida. The selection is exceptional and the family is incredible!",
            "author": "Sarah M."
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "You can taste the passion and history in every bottle. Open Container is a hidden gem!",
            "author": "Michael T."
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "The atmosphere, the wine, the people — everything is perfect. We'll definitely be back!",
            "author": "Jessica L."
          }
        }
      ]
    }
  ]
}
{% endschema %}
