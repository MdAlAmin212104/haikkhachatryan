{% comment %}
  Visit Us — What to Expect Section
  Dark background image with eyebrow, heading, and 4-column icon feature grid.
  "A Memorable Experience"
{% endcomment %}

{%- assign bg_img = section.settings.background_image -%}
<section
  id="visit-us-expect-{{ section.id }}"
  class="visit-us-expect"
  {%- if bg_img != blank -%}
    style="background-image: url({{ bg_img | image_url: width: 2000 }}); background-color: {{ section.settings.background_color }};"
  {%- else -%}
    style="background-color: {{ section.settings.background_color }};"
  {%- endif -%}
>
  <div class="visit-us-expect__overlay"></div>
  <div class="section">
  <div
    class="visit-us-expect__inner page-width"
    style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
  >

    <div class="visit-us-expect__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="visit-us-expect__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="visit-us-expect__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="visit-us-expect__grid">
        {%- for block in section.blocks -%}
          <div class="visit-us-expect__card" {{ block.shopify_attributes }}>
            <div class="visit-us-expect__card-icon">
              {%- if block.settings.icon != blank -%}
                <span>{{ block.settings.icon }}</span>
              {%- endif -%}
            </div>
            <div class="visit-us-expect__card-text">
              {%- if block.settings.title != blank -%}
                <h3 class="visit-us-expect__card-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="visit-us-expect__card-desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
  </div>
</section>

{% stylesheet %}
  /* ── Base ─────────────────────────────────── */
  .visit-us-expect {
    position: relative;
    width: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .visit-us-expect__overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 10, 10, 0.72);
    pointer-events: none;
  }

  .visit-us-expect__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* ── Header ───────────────────────────────── */
  .visit-us-expect__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
  }

  .visit-us-expect__eyebrow {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: white;
    margin: 0;
  }

  .visit-us-expect__heading {
    font-size: clamp(1.4rem, 4vw, 2.2rem);
    font-weight: 700;
    color: #fff;
    margin: 0;
    line-height: 1.2;
  }

  /* ── Grid — desktop 4 cols ────────────────── */
  .visit-us-expect__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  /* ── Card — always vertical ───────────────── */
  .visit-us-expect__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 1.75rem 1rem;
    transition: transform 0.2s;
  }

  .visit-us-expect__card:hover {
    transform: translateY(-4px);
  }

  .visit-us-expect__card-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    color: #c0392b;
  }

  .visit-us-expect__card-icon svg,
  .visit-us-expect__card-icon img {
    width: 40px;
    height: 40px;
    display: block;
  }

  .visit-us-expect__card-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .visit-us-expect__card-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
  }

  .visit-us-expect__card-desc {
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Tablet: 2 columns, same card layout ──── */
  @media screen and (max-width: 900px) {
    .visit-us-expect__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .visit-us-expect__card {
      padding: 1.5rem 0.875rem;
    }
  }

  /* ── Mobile: 2 columns, tighter ──────────── */
  @media screen and (max-width: 549px) {
    .visit-us-expect__inner {
      gap: 2rem;
    }

    .visit-us-expect__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }

    .visit-us-expect__card {
      /* Keep vertical — icon top, title, desc */
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 1.25rem 0.625rem;
      gap: 0.5rem;
    }

    .visit-us-expect__card-icon {
      width: 52px;
      height: 52px;
    }

    .visit-us-expect__card-icon svg,
    .visit-us-expect__card-icon img {
      width: 32px;
      height: 32px;
    }

  
  }

  /* ── Mobile: 1 column ─────────────────────── */
  @media screen and (max-width: 549px) {
    .visit-us-expect__inner {
      gap: 2rem;
    }

    .visit-us-expect__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .visit-us-expect__card {
      flex-direction: row;
      text-align: left;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.1rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .visit-us-expect__card:last-child {
      border-bottom: none;
    }

    .visit-us-expect__card-icon {
      flex-shrink: 0;
      width: 48px;
      height: 48px;
      margin-top: 2px;
    }

    .visit-us-expect__card-icon svg,
    .visit-us-expect__card-icon img {
      width: 32px;
      height: 32px;
    }

    .visit-us-expect__card-text {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    

    .visit-us-expect__heading {
      font-size: clamp(1.35rem, 6vw, 1.8rem);
    }
  }
{% endstylesheet %}

