{% doc %}
  @prompt
    Create a premium “Tasting Room Perk” section for the Open Container membership page.
    
    Heading:
    “Your Membership Comes With You”
    
    Description:
    “Visit any Open Container location and bring up to two guests for a complimentary tasting flight. Reservations recommended.”
    
    Add a prominent CTA button:
    “FIND A LOCATION”
    
    Button link:
    `/pages/visit-us`
    
    Design requirements:
    
    * Create a clean, premium section that highlights the membership perk.
    * Make the heading visually prominent.
    * Keep the description easy to read with comfortable spacing.
    * Make the “FIND A LOCATION” button prominent and clearly clickable.
    * Use the existing Open Container wine brand typography and styling.
    * Keep the layout elegant and spacious.
    * Fully responsive on desktop and mobile.
    * Do not use stock photography or unnecessary decorative elements.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-tasting-room-perk-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; margin: 0 auto; padding: {{ block.settings.vertical_padding }}px 24px; background: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; box-sizing: border-box; }
  .ai-tasting-room-perk-{{ ai_gen_id }}__inner { width: 100%; max-width: 760px; margin: 0 auto; text-align: center; }
  .ai-tasting-room-perk-{{ ai_gen_id }}__eyebrow { margin: 0 0 18px; color: {{ block.settings.accent_color }}; font-family: {{ block.settings.accent_font.family }}, {{ block.settings.accent_font.fallback_families }}; font-size: 13px; font-weight: 600; letter-spacing: .16em; line-height: 1.4; text-transform: uppercase; }
  .ai-tasting-room-perk-{{ ai_gen_id }}__heading { margin: 0; color: {{ block.settings.text_color }}; font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }}; font-size: {{ block.settings.heading_size }}px; font-weight: 400; letter-spacing: -.02em; line-height: 1.08; }
  .ai-tasting-room-perk-{{ ai_gen_id }}__description { max-width: 620px; margin: 24px auto 0; color: {{ block.settings.text_color }}; font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }}; font-size: {{ block.settings.description_size }}px; line-height: 1.7; }
  .ai-tasting-room-perk-{{ ai_gen_id }}__button { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; margin-top: 34px; padding: 15px 30px; border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_color }}; border-radius: {{ block.settings.button_radius }}px; background: {{ block.settings.button_color }}; color: {{ block.settings.button_text_color }}; font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }}; font-size: 13px; font-weight: 600; letter-spacing: .12em; line-height: 1.2; text-decoration: none; text-transform: uppercase; transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease; }
  .ai-tasting-room-perk-{{ ai_gen_id }}__button:hover { border-color: {{ block.settings.button_hover_color }}; background: {{ block.settings.button_hover_color }}; color: {{ block.settings.button_hover_text_color }}; }
  .ai-tasting-room-perk-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid {{ block.settings.focus_color }}; outline-offset: 4px; }
  @media screen and (max-width: 749px) { .ai-tasting-room-perk-{{ ai_gen_id }} { padding: {{ block.settings.mobile_vertical_padding }}px 20px; } .ai-tasting-room-perk-{{ ai_gen_id }}__heading { font-size: {{ block.settings.mobile_heading_size }}px; } .ai-tasting-room-perk-{{ ai_gen_id }}__description { font-size: 16px; } .ai-tasting-room-perk-{{ ai_gen_id }}__button { width: 100%; max-width: 320px; } }
{% endstyle %}
<div class="ai-tasting-room-perk-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-tasting-room-perk-{{ ai_gen_id }}__inner">
    {% if block.settings.eyebrow != blank %}<p class="ai-tasting-room-perk-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
    <h2 class="ai-tasting-room-perk-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    <div class="ai-tasting-room-perk-{{ ai_gen_id }}__description">{{ block.settings.description | escape }}</div>
    {% if block.settings.button_link != blank %}<a class="ai-tasting-room-perk-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Tasting room perk",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Tasting room perk" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Membership Comes With You" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Visit any Open Container location and bring up to two guests for a complimentary tasting flight. Reservations recommended." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "FIND A LOCATION" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "vertical_padding", "label": "Desktop spacing", "min": 40, "max": 160, "step": 10, "unit": "px", "default": 100 },
    { "type": "range", "id": "mobile_vertical_padding", "label": "Mobile spacing", "min": 32, "max": 100, "step": 4, "unit": "px", "default": 64 },
    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "lora_n4" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "poppins_n4" },
    { "type": "font_picker", "id": "accent_font", "label": "Eyebrow font", "default": "poppins_n4" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 32, "max": 72, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 28, "max": 52, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 14, "max": 22, "step": 1, "unit": "px", "default": 18 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FDF8F3" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "accent_color", "label": "Eyebrow", "default": "#6B1A2E" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#6B1A2E" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FDF8F3" },
    { "type": "color", "id": "button_hover_color", "label": "Button hover", "default": "#40101C" },
    { "type": "color", "id": "button_hover_text_color", "label": "Hover text", "default": "#FFFFFF" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#000000" },
    { "type": "range", "id": "button_border_width", "label": "Button border", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 14 }
  ],
  "presets": [{ "name": "Tasting room perk" }],
  "tag": null,
  "class": "tasting-room-perk-block"
}
{% endschema %}