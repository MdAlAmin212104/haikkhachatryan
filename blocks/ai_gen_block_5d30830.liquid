{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-offer-{{ ai_gen_id }} { display:block; width:100%; background:{{ block.settings.background_color }}; padding:{{ block.settings.section_padding }}px 0px; }
  .ai-offer-{{ ai_gen_id }}__heading { margin:0 0 42px; color:{{ block.settings.heading_color }}; text-align:center; font-family:{{ settings.type_heading_font.family }},serif; font-size:{{ block.settings.heading_size }}px; font-weight:400; line-height:1.15; }
  .ai-offer-{{ ai_gen_id }}__grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:{{ block.settings.card_gap }}px; align-items:stretch; }
  .ai-offer-{{ ai_gen_id }}__card { display:flex; flex-direction:column; min-width:0; background:{{ block.settings.panel_color }}; border-radius:{{ block.settings.card_radius }}px; overflow:hidden; }
  .ai-offer-{{ ai_gen_id }}__image-wrap { position:relative; aspect-ratio:4 / 3; background:#eadfd7; overflow:hidden; }
  .ai-offer-{{ ai_gen_id }}__image-wrap img,.ai-offer-{{ ai_gen_id }}__image-wrap svg { display:block; width:100%; height:100%; object-fit:cover; }
  .ai-offer-{{ ai_gen_id }}__image-wrap svg { color:#7c6b62; padding:18%; }
  .ai-offer-{{ ai_gen_id }}__content { display:flex; flex:1; flex-direction:column; padding:30px 28px 34px; }
  .ai-offer-{{ ai_gen_id }}__title { margin:0 0 16px; color:{{ block.settings.panel_text_color }}; font-family:{{ settings.type_heading_font.family }},serif; font-size:{{ block.settings.title_size }}px; font-weight:400; line-height:1.2; }
  .ai-offer-{{ ai_gen_id }}__description { margin:0; color:{{ block.settings.panel_text_color }}; font-family:{{ settings.type_body_font.family }},sans-serif; font-size:{{ block.settings.body_size }}px; line-height:1.65; }
  @media screen and (max-width:749px) {  .ai-offer-{{ ai_gen_id }}__inner { width:100%; } .ai-offer-{{ ai_gen_id }}__heading { margin-bottom:30px; font-size:38px; } .ai-offer-{{ ai_gen_id }}__grid { grid-template-columns:1fr; gap:24px; } }
{% endstyle %}
<div class="ai-offer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-offer-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-offer-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>{% endif %}
    <div class="ai-offer-{{ ai_gen_id }}__grid">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'card_' | append: i | append: '_image'
          assign title_key = 'card_' | append: i | append: '_title'
          assign description_key = 'card_' | append: i | append: '_description'
          assign card_image = block.settings[image_key]
          assign card_title = block.settings[title_key]
          assign card_description = block.settings[description_key]
        %}
        <article class="ai-offer-{{ ai_gen_id }}__card">
          <div class="ai-offer-{{ ai_gen_id }}__image-wrap">
            {% if card_image != blank %}<img src="{{ card_image | image_url: width: 1200 }}" alt="{{ card_title | escape }}" loading="lazy" width="{{ card_image.width }}" height="{{ card_image.height }}">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}
          </div>
          <div class="ai-offer-{{ ai_gen_id }}__content"><h3 class="ai-offer-{{ ai_gen_id }}__title">{{ card_title }}</h3><p class="ai-offer-{{ ai_gen_id }}__description">{{ card_description }}</p></div>
        </article>
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}
{"name":"What we offer","tag":null,"class":"what-we-offer-block","settings":[{"type":"text","id":"heading","label":"Heading","default":"What We Offer"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"section_padding","label":"Section padding","min":20,"max":100,"step":5,"unit":"px","default":70},{"type":"range","id":"card_gap","label":"Card spacing","min":12,"max":48,"step":4,"unit":"px","default":24},{"type":"range","id":"heading_size","label":"Heading size","min":24,"max":72,"step":4,"unit":"px","default":48},{"type":"range","id":"title_size","label":"Title size","min":18,"max":40,"step":2,"unit":"px","default":26},{"type":"range","id":"body_size","label":"Body size","min":12,"max":22,"step":1,"unit":"px","default":16},{"type":"color","id":"background_color","label":"Background","default":"#FDF8F3"},{"type":"color","id":"heading_color","label":"Heading","default":"#000000"},{"type":"color","id":"panel_color","label":"Panel","default":"#6B1A2E"},{"type":"color","id":"panel_text_color","label":"Panel text","default":"#FFFFFF"},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":24,"step":2,"unit":"px","default":0},{"type":"header","content":"Card 1"},{"type":"image_picker","id":"card_1_image","label":"Event photograph"},{"type":"text","id":"card_1_title","label":"Title","default":"Selecting The Wines"},{"type":"textarea","id":"card_1_description","label":"Description","default":"A proper tasting runs five wines: two whites, two reds, and a sweet. We pour them side by side so your guests taste the contrast, not just the wine. Every bottle is our own — exclusive private label from our family vineyard in Armenia."},{"type":"header","content":"Card 2"},{"type":"image_picker","id":"card_2_image","label":"Event photograph"},{"type":"text","id":"card_2_title","label":"Title","default":"Choosing A Theme"},{"type":"textarea","id":"card_2_description","label":"Description","default":"A theme announced in advance builds anticipation before anyone walks in. Around the world in five glasses. Old world against new. A vertical of a single varietal. Reds only. Tell us the crowd and we'll tell you what will land."},{"type":"header","content":"Card 3"},{"type":"image_picker","id":"card_3_image","label":"Event photograph"},{"type":"text","id":"card_3_title","label":"Title","default":"Food Pairing"},{"type":"textarea","id":"card_3_description","label":"Description","default":"Sip & Sweets — wine and dessert, for the sweet tooth in the room. Soul Mates — cheese and wine, matched pair by pair. Full Dinner Pairing — a course-by-course build for a seated event."}],"presets":[{"name":"What we offer"}]}
{% endschema %}