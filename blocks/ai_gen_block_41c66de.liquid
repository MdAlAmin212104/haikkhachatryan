{% doc %}
  @prompt
    Create a small, centered “Shipping Note” section directly below the membership plan cards.
    
    Content:
    
    “We ship to select states only.”
    
    Add a text link:
    “See where we ship”
    
    Below that, add:
    “All shipments require an adult signature from someone 21 or older.”
    
    Design requirements:
    
    * Keep the section compact and visually secondary to the membership plans.
    * Center-align all text.
    * Use clean, elegant typography matching the Open Container wine club design.
    * Make “See where we ship” look clearly clickable.
    * Use subtle spacing between the two statements.
    * Do not add images, icons, or unnecessary design elements.
    * Make it fully responsive on desktop and mobile.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shipping-note-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.top_spacing }}px 16px {{ block.settings.bottom_spacing }}px;
    text-align: center;
    color: {{ settings.page_text_color }};
    font-family: {{ settings.type_body_font.family }}, sans-serif;
  }

  .ai-shipping-note-{{ ai_gen_id }}__primary {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .ai-shipping-note-{{ ai_gen_id }}__link {
    display: inline-block;
    margin-top: 4px;
    color: {{ settings.palette_secondary_button_text }};
    font-size: 14px;
    line-height: 1.5;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .ai-shipping-note-{{ ai_gen_id }}__link:hover {
    opacity: 0.72;
  }

  .ai-shipping-note-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }

  .ai-shipping-note-{{ ai_gen_id }}__secondary {
    margin: 12px 0 0;
    color: {{ settings.color_palette.color1 }};
    font-size: 12px;
    line-height: 1.55;
  }

  @media screen and (max-width: 749px) {
    .ai-shipping-note-{{ ai_gen_id }} {
      padding-right: 12px;
      padding-left: 12px;
    }
  }
{% endstyle %}

<div class="ai-shipping-note-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <p class="ai-shipping-note-{{ ai_gen_id }}__primary">
    {{ block.settings.shipping_statement }}
  </p>
  {% if block.settings.shipping_link != blank %}
    <a class="ai-shipping-note-{{ ai_gen_id }}__link" href="{{ block.settings.shipping_link }}">
      {{ block.settings.shipping_link_label }}
    </a>
  {% endif %}
  <p class="ai-shipping-note-{{ ai_gen_id }}__secondary">
    {{ block.settings.signature_statement }}
  </p>
</div>

{% schema %}
{
  "name": "Shipping note",
  "settings": [
    {
      "type": "text",
      "id": "shipping_statement",
      "label": "Shipping statement",
      "default": "We ship to select states only."
    },
    {
      "type": "text",
      "id": "shipping_link_label",
      "label": "Link label",
      "default": "See where we ship"
    },
    {
      "type": "url",
      "id": "shipping_link",
      "label": "Shipping information link"
    },
    {
      "type": "text",
      "id": "signature_statement",
      "label": "Signature statement",
      "default": "All shipments require an adult signature from someone 21 or older."
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "top_spacing",
      "label": "Top spacing",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "Bottom spacing",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Shipping note"
    }
  ],
  "tag": null,
  "class": "shipping-note-block"
}
{% endschema %}