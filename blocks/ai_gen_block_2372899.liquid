{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-wine-methods-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-wine-methods__heading-{{ ai_gen_id }} {
    margin: 0 0 44px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 400;
    line-height: 1.1;
    text-align: center;
  }

  .ai-wine-methods__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .ai-wine-methods__card-{{ ai_gen_id }} {
    min-height: 250px;
    padding: 34px 30px 30px;
    border: 1px solid {{ block.settings.border_color }};
    background: {{ block.settings.card_color }};
    text-align: center;
  }

  .ai-wine-methods__icon-{{ ai_gen_id }} {
    display: flex;
    width: 58px;
    height: 58px;
    margin: 0 auto 22px;
    align-items: center;
    justify-content: center;
    border: 1px solid {{ block.settings.accent_color }};
    border-radius: 50%;
    color: {{ block.settings.accent_color }};
  }

  .ai-wine-methods__icon-{{ ai_gen_id }} svg {
    width: 27px;
    height: 27px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .ai-wine-methods__title-{{ ai_gen_id }} {
    margin: 0 0 14px;
    color: {{ block.settings.heading_color }};
    font-size: 25px;
    font-weight: 400;
    line-height: 1.2;
  }

  .ai-wine-methods__copy-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.65;
  }

  .ai-wine-methods__copy-{{ ai_gen_id }} strong {
    color: {{ block.settings.accent_color }};
    font-weight: 600;
  }

  .ai-wine-methods__support-{{ ai_gen_id }} {
    max-width: 720px;
    margin: 40px auto 0;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.6;
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    .ai-wine-methods__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {

    .ai-wine-methods__heading-{{ ai_gen_id }} {
      margin-bottom: 32px;
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-wine-methods__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-wine-methods__card-{{ ai_gen_id }} {
      min-height: 0;
      padding: 30px 24px 27px;
    }
  }
{% endstyle %}

<div class="ai-wine-methods-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-wine-methods__inner-{{ ai_gen_id }}">
    <h2 class="ai-wine-methods__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    <div class="ai-wine-methods__grid-{{ ai_gen_id }}">
      <article class="ai-wine-methods__card-{{ ai_gen_id }}">
        <div class="ai-wine-methods__icon-{{ ai_gen_id }}" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M3 7h11v10H3zM14 10h3l4 4v3h-7zM6 20h.01M18 20h.01"/><path d="M14 14h7M6 17h.01M18 17h.01"/></svg>
        </div>
        <h3 class="ai-wine-methods__title-{{ ai_gen_id }}">{{ block.settings.ship_title }}</h3>
        <p class="ai-wine-methods__copy-{{ ai_gen_id }}">{{ block.settings.ship_copy | replace: '21 or older', '<strong>21 or older</strong>' }}</p>
      </article>
      <article class="ai-wine-methods__card-{{ ai_gen_id }}">
        <div class="ai-wine-methods__icon-{{ ai_gen_id }}" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 10h16M5 10l1-5h12l1 5M6 10v9h12v-9M9 19v-5h6v5M8 5V3h8v2"/></svg>
        </div>
        <h3 class="ai-wine-methods__title-{{ ai_gen_id }}">{{ block.settings.pick_title }}</h3>
        <p class="ai-wine-methods__copy-{{ ai_gen_id }}">{{ block.settings.pick_copy }}</p>
      </article>
      <article class="ai-wine-methods__card-{{ ai_gen_id }}">
        <div class="ai-wine-methods__icon-{{ ai_gen_id }}" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5M5 10v9h14v-9M9 19v-5h6v5"/><path d="M18 4v3M16.5 5.5h3"/></svg>
        </div>
        <h3 class="ai-wine-methods__title-{{ ai_gen_id }}">{{ block.settings.delivery_title }}</h3>
        <p class="ai-wine-methods__copy-{{ ai_gen_id }}">{{ block.settings.delivery_copy | replace: '21 or older', '<strong>21 or older</strong>' }}</p>
      </article>
    </div>
    <p class="ai-wine-methods__support-{{ ai_gen_id }}">{{ block.settings.supporting_text }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Wine delivery methods",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three Ways To Get Your Wine" },
    { "type": "text", "id": "ship_title", "label": "Shipping title", "default": "Ship It" },
    { "type": "textarea", "id": "ship_copy", "label": "Shipping description", "default": "Delivered to your door in states where we are permitted to ship. An adult 21 or older must sign." },
    { "type": "text", "id": "pick_title", "label": "Pickup title", "default": "Pick It Up" },
    { "type": "textarea", "id": "pick_copy", "label": "Pickup description", "default": "Collect at any Open Container location, free. We hold your shipment for 45 days." },
    { "type": "text", "id": "delivery_title", "label": "Local delivery title", "default": "Orlando Delivery" },
    { "type": "textarea", "id": "delivery_copy", "label": "Local delivery description", "default": "Inside the City of Orlando we bring it to you. Someone 21 or older must be there to receive it." },
    { "type": "textarea", "id": "supporting_text", "label": "Supporting text", "default": "Choose your method at checkout. You can change it any time before a shipment processes." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 72, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 22, "max": 48, "step": 2, "unit": "px", "default": 32 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FDF8F3" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#333333" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#6B1A2E" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#DFDFDF" }
  ],
  "presets": [{ "name": "Wine delivery methods" }],
  "tag": null,
  "class": "wine-delivery-methods-block"
}
{% endschema %}